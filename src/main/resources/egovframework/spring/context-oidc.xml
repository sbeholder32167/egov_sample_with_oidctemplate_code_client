<!--
   OIDC Template Code 설정 Sample XML (Spring Security 사용 시 적용 - Spring Security 설정은 분리됨)
   @author : sbeholder6684
   @version : v1.0.0
   @since : 2026-08-05
-->
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:mvc="http://www.springframework.org/schema/mvc"
    xmlns:task="http://www.springframework.org/schema/task"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
        http://www.springframework.org/schema/mvc http://www.springframework.org/schema/mvc/spring-mvc-4.0.xsd
        http://www.springframework.org/schema/task http://www.springframework.org/schema/task/spring-task-4.0.xsd">

    <!-- OIDC Config Bean -->
    <bean id="OIDCConfig" class="io.github.sbeholder32167.oidctemplate.client.OIDCConfig">
        <property name="clientId" value="easy_company3" />
        <property name="clientSecret" value="YlGEPVIylcsVZq5IHcNiMlNc6NBoJzus"/>
        <property name="redirectUri" value="http://localhost:8080/sample/keycloak/oidc_code.do" />
        <property name="authenticationEndpoint" value="https://keycloak-idp:8443/realms/Demonstration/protocol/openid-connect/auth" />
        <property name="tokenEndpoint" value="https://keycloak-idp:8443/realms/Demonstration/protocol/openid-connect/token" />
        <property name="jwksUri" value="https://keycloak-idp:8443/realms/Demonstration/protocol/openid-connect/certs"/>
        <property name="logoutUri" value="https://keycloak-idp:8443/realms/Demonstration/protocol/openid-connect/logout" />
        <property name="postLogoutUri" value="http://localhost:8080/sample/index.jsp" />
        <property name="scope" value="openid profile email"/>
        <!-- 추후 Factory Pattern으로의 확장 고려 -->
        <property name="provider" value="KEYCLOAK"/>
    </bean>

    <!-- OIDC Request Parameter Storage -->
    <bean id="OIDCAuthParameterStorage" class="io.github.sbeholder32167.oidctemplate.client.session.storage.impl.LocalMemoryAuthParameterStorage" />
    <!-- OIDC Keycloak Provider -->
    <bean id="OIDCProvider" class="io.github.sbeholder32167.oidctemplate.client.provider.impl.KeycloakProvider">
        <constructor-arg index="0" ref="OIDCConfig" />
        <constructor-arg index="1" ref="restfulUtil" />
        <constructor-arg index="2" ref="OIDCAuthParameterStorage" />
        <property name="defaultAccessTokenDurationSec" value="300" />
        <property name="defaultRefreshTokenDurationSec" value="1800" />
    </bean>

    <!-- OIDC Session Duplicate Policy -->
    <bean id="OIDCSessionDuplicatePolicy" class="io.github.sbeholder32167.oidctemplate.client.session.duplicatepolicy.impl.MaxDenySessionDuplicatePolicy">
        <property name="maxSessionCnt" value="1" />
    </bean>
    <!--
    <beans:bean id="OIDCSessionDuplicatePolicy" class="io.github.sbeholder32167.oidctemplate.client.session.duplicatepolicy.impl.OneAllowSessionDuplicatePolicy" />
    -->

    <!-- OIDC Auto Token Checker -->
    <bean id="OIDCAutoTokenChecker" class="io.github.sbeholder32167.oidctemplate.client.session.refresh.impl.AccessTokenAutoTokenChecker" />
    <!-- <bean id="OIDCAutoTokenChecker" class="io.github.sbeholder32167.oidctemplate.session.refresh.impl.RefreshTokenAutoTokenChecker" /> -->
    <!-- OIDC Session Repository -->
    <bean id="OIDCSessionRepository" class="io.github.sbeholder32167.oidctemplate.client.session.repository.impl.LocalMapSessionRepository" />
    <!-- OIDC Session Registry -->
    <bean id="OIDCSessionRegistry" class="io.github.sbeholder32167.oidctemplate.client.session.registry.impl.LocalMapSessionRegistry">
        <constructor-arg index="0" ref="OIDCSessionRepository"/>
    </bean>

    <!-- OIDC Session Manager -->
    <bean id="OIDCSessionManager" class="io.github.sbeholder32167.oidctemplate.client.session.OIDCSessionManager" >
        <constructor-arg index="0" ref="OIDCProvider" />
        <constructor-arg index="1" ref="OIDCSessionRegistry" />
        <constructor-arg index="2" ref="OIDCAuthParameterStorage" />
        <constructor-arg index="3" ref="clientLegacySessionAdapter" />
        <property name="sessionDuplicatePolicy" ref="OIDCSessionDuplicatePolicy" />
        <property name="timeoutSec" value="1800" />
        <property name="idpSessionTimeoutSec" value="1800" />
        <property name="skewSec" value="60" />
        <property name="autoTokenChecker" ref="OIDCAutoTokenChecker" />
    </bean>

    <!-- Restful Strategy for Restful Object -->
    <bean id="allAllowRestStrategy" class="io.github.sbeholder32167.oidctemplate.rest.strategy.AllAllowStrategy" />
    <bean id="normalRestStrategy" class="io.github.sbeholder32167.oidctemplate.rest.strategy.NormalStrategy" />
    <!-- Rest Object -->
    <bean id="restfulUtil" class="io.github.sbeholder32167.oidctemplate.rest.RestfulUtil">
        <!-- use in Development only. -->
        <!-- <constructor-arg index="0" ref="allAllowRestStrategy" /> -->
        <!-- use Staging, Production. -->
        <constructor-arg index="0" ref="normalRestStrategy" />
    </bean>

    <!-- OIDC Adapters : CUSTOMIZING AREA : Adapter Beans -->
    <bean id="clientLoginAdapter" class="egovframework.rte.tex.adapter.EgovLoginAdapterImpl" />
    <bean id="clientLogoutAdapter" class="egovframework.rte.tex.adapter.EgovLogoutAdapterImpl" />
    <bean id="clientAuthConvertAdapter" class="egovframework.rte.tex.adapter.EgovAuthConvertAdapterImpl" />
    <bean id="OIDCExceptionHandler" class="egovframework.rte.tex.adapter.EgovOIDCExceptionHandlerImpl" />
    <bean id="clientLegacySessionAdapter" class="egovframework.rte.tex.adapter.EgovSessionAdapterImpl" />
    <!-- ABAC Exception Adapter : Not source Included.
    <bean id="clientAuthzExceptionAdapter" class="com.example.legacy.adapter.LegacyAuthzExceptionAdapterImpl" />
    -->

    <!-- OIDC Authentication Success Handler -->
    <bean id="OIDCAuthSuccessHandler" class="io.github.sbeholder32167.oidctemplate.client.security.OIDCAuthSuccessHandler">
        <constructor-arg index="0" ref="OIDCSessionManager" />
        <property name="loginSuccessUri" value="/com/egovMain.do" />
        <property name="clientLoginAdapter" ref="clientLoginAdapter" />
    </bean>
    <!-- OIDC Authentication Failure Handler -->
    <bean id="OIDCAuthFailureHandler" class="io.github.sbeholder32167.oidctemplate.client.security.OIDCAuthFailureHandler" >
        <constructor-arg index="0" value="/index.jsp" />
        <property name="clientLoginAdapter" ref="clientLoginAdapter" />
    </bean>

    <!-- OIDC Filter with Spring Security -->
    <bean id="OIDCLoginFilter" class="io.github.sbeholder32167.oidctemplate.client.security.OIDCLoginFilter">
        <constructor-arg index="0" value="/keycloak/oidc.do" />
        <constructor-arg index="1" value="/keycloak/oidc_code.do" />
        <constructor-arg index="2" ref="OIDCProvider" />
        <property name="exceptionHandler" ref="OIDCExceptionHandler" />
        <!-- inherited -->
        <property name="authenticationManager" ref="org.springframework.security.authenticationManager" />
        <property name="authenticationSuccessHandler" ref="OIDCAuthSuccessHandler"/>
        <property name="authenticationFailureHandler" ref="OIDCAuthFailureHandler" />
    </bean>
    <!-- OIDC Provider -->
    <bean id="OIDCAuthenticationProvider" class="io.github.sbeholder32167.oidctemplate.client.security.OIDCAuthenticationProvider">
        <constructor-arg index="0" ref="OIDCProvider" />
        <constructor-arg index="1" ref="clientAuthConvertAdapter" />
        <constructor-arg index="2" ref="OIDCSessionManager" />
    </bean>
    <!-- OIDC Logout Filter -->
    <bean id="OIDCLogoutFilter" class="io.github.sbeholder32167.oidctemplate.client.OIDCLogoutFilter">
        <constructor-arg index="0" ref="OIDCProvider" />
        <constructor-arg index="1" ref="OIDCSessionManager" />
        <constructor-arg index="2" ref="clientLogoutAdapter" />
        <property name="manualLogoutUri" value="/keycloak/oidc_logout.do" />
        <property name="idpLogoutUri" value="/keycloak/logout.do" />
        <property name="exceptionHandler" ref="OIDCExceptionHandler" />
    </bean>
    <!-- OIDC Session Interceptor -->
    <bean id="OIDCSessionInterceptor" class="io.github.sbeholder32167.oidctemplate.client.session.OIDCSessionInterceptor">
        <constructor-arg index="0" ref="OIDCSessionManager" />
        <constructor-arg index="1" ref="OIDCAuthParameterStorage" />
        <property name="mainPageUri" value="/com/egovMain.do" />
        <property name="exceptionUri" value="/index.jsp" />
    </bean>

    <!-- for Egov Security Tag -->
    <bean id="oidcFilterInjector" class="io.github.sbeholder32167.oidctemplate.egov.OIDCFilterInjector">
        <constructor-arg index="0" ref="OIDCLoginFilter" />
        <constructor-arg index="1" ref="OIDCLogoutFilter" />
    </bean>
    <bean id="oidcProviderInjector" class="io.github.sbeholder32167.oidctemplate.egov.OIDCProviderInjector">
        <constructor-arg index="0" ref="OIDCAuthenticationProvider" />
    </bean>

    <mvc:interceptors>
        <mvc:interceptor>
            <mvc:mapping path="/**"/>
            <mvc:exclude-mapping path="/css/**"/>
            <mvc:exclude-mapping path="/js/**"/>
            <mvc:exclude-mapping path="/images/**"/>
            <mvc:exclude-mapping path="/GoodsImage/**"/>
            <mvc:exclude-mapping path="/com/ajax.do"/>
            <mvc:exclude-mapping path="/mbr/loginView.do"/>
            <mvc:exclude-mapping path="/keycloak/oidc.do"/>
            <mvc:exclude-mapping path="/keycloak/oidc_code.do"/>
            <mvc:exclude-mapping path="/mbr/logout.do"/>
            <ref bean="OIDCSessionInterceptor"/>
        </mvc:interceptor>
    </mvc:interceptors>

    <task:annotation-driven/>
</beans>